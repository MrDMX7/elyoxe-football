+"""«توقع وتحدى ربعك» (src/tifo_predict.py) against an in-memory table that keeps DynamoDB's promises: conditional writes and
+all-or-nothing transactions. No AWS. Run: python3 -m pytest tests/test_tifo_predict.py"""
+import copy, json, os, sys, threading
+from datetime import datetime, timedelta, timezone
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "src"))
+os.environ.setdefault("AWS_DEFAULT_REGION", "ap-south-1")
+import pytest
+import app
+import tifo_predict as TP
+
+T0 = datetime(2026, 10, 10, 12, 0, tzinfo=timezone.utc)
+
+
+class Killed(BaseException):
+    """The Lambda timing out in the middle of a run."""
+
+
+class MemDB:
+    def __init__(self):
+        self.items, self.lock, self.tx, self.kill_at = {}, threading.RLock(), 0, None
+
+    @staticmethod
+    def ok(it, cond):
+        for c in cond or []:
+            if c == "absent" and it is not None or c == "present" and it is None:
+                return False
+            if isinstance(c, tuple):
+                v = (it or {}).get(c[1])
+                if c[0] == "lt" and v is not None and not v < c[2]:
+                    return False
+                if c[0] == "eq" and v != c[2]:
+                    return False
+                if c[0] == "size_lt" and v is not None and not len(v) < c[2]:
+                    return False
+        return True
+
+    def _upd(self, key, add=None, set_=None, append=None, remove=None):
+        it = self.items.get(key) or {"pk": key[0], "sk": key[1]}
+        for a, v in (set_ or {}).items():
+            it[a] = copy.deepcopy(v)
+        for a, v in (append or {}).items():
+            it[a] = list(it.get(a) or []) + list(v)
+        for a, v in (add or {}).items():
+            it[a] = it.get(a, 0) + v
+        for a in remove or []:
+            it.pop(a, None)
+        self.items[key] = it
+
+    def get(self, pk, sk, consistent=False):
+        return copy.deepcopy(self.items.get((pk, sk)))
+
+    def put(self, item, cond=None):
+        with self.lock:
+            k = (item["pk"], item["sk"])
+            if not self.ok(self.items.get(k), cond):
+                return False
+            self.items[k] = copy.deepcopy(item)
+            return True
+
+    def update(self, pk, sk, add=None, set_=None, append=None, remove=None, cond=None, ret=False):
+        with self.lock:
+            if not self.ok(self.items.get((pk, sk)), cond):
+                return None if ret else False
+            self._upd((pk, sk), add, set_, append, remove)
+            return copy.deepcopy(self.items[(pk, sk)]) if ret else True
+
+    def delete(self, pk, sk, cond=None):
+        with self.lock:
+            if not self.ok(self.items.get((pk, sk)), cond):
+                return False
+            self.items.pop((pk, sk), None)
+            return True
+
+    def query(self, pk, prefix=None, upto=None, limit=None, desc=False, consistent=False):
+        rows = sorted((v for (p, s), v in self.items.items() if p == pk and (prefix is None or s.startswith(prefix)) and (upto is None or s <= upto)),
+                      key=lambda v: v["sk"], reverse=desc)
+        return copy.deepcopy(rows[:limit] if limit else rows)
+
+    def batch_get(self, keys):
+        return [copy.deepcopy(self.items[k]) for k in dict.fromkeys(keys) if k in self.items]
+
+    def transact(self, ops):
+        with self.lock:
+            if self.kill_at is not None and self.tx >= self.kill_at:
+                raise Killed()
+            keys = [(o["put"]["pk"], o["put"]["sk"]) if "put" in o else tuple(o.get("update") or o.get("delete") or o.get("check")) for o in ops]
+            why = ["None" if self.ok(self.items.get(k), o.get("cond")) else "ConditionalCheckFailed" for k, o in zip(keys, ops)]
+            if any(w != "None" for w in why):
+                return False, why
+            for k, o in zip(keys, ops):
+                if "put" in o:
+                    self.items[k] = copy.deepcopy(o["put"])
+                elif "update" in o:
+                    self._upd(k, o.get("add"), o.get("set"), o.get("append"), o.get("remove"))
+                elif "delete" in o:
+                    self.items.pop(k, None)
+            self.tx += 1
+            return True, []
+
+
+def md(mid, ko, status="scheduled", score=None, comp=538, **kw):
+    return {"id": mid, "status": status, "kickoff_utc": ko, "comp": comp, "comp_name_ar": "دوري أدنوك",
+            "home": {"id": 1, "name": "Al Ain", "name_ar": "العين"}, "away": {"id": 2, "name": "Al Wahda", "name_ar": "الوحدة"},
+            "score": {"home": score[0], "away": score[1]} if score else None, **kw}
