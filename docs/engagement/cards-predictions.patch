+# ------------------------------------------------------------------ the production table layer builds valid requests
+class _Rec:
+    """boto3 Table and client stand-ins that check every placeholder is defined and every value serialized."""
+    def __init__(self):
+        self.calls = []
+        self.name = "cards"
+        rec = self
+
+        class C:
+            def transact_write_items(self, TransactItems):
+                rec.calls.append(("tx", TransactItems))
+                for it in TransactItems:
+                    body = next(iter(it.values()))
+                    rec.check(body.get("UpdateExpression", "") + " " + body.get("ConditionExpression", ""), body)
+                    for v in (body.get("ExpressionAttributeValues") or {}).values():
+                        assert isinstance(v, dict) and len(v) == 1                         # {"N": "5"}, {"S": …}, {"L": …}
+        self.meta = type("M", (), {"client": C()})
+
+    def check(self, expr, kw):
+        import re
+        for ph in re.findall(r"#a\d+", expr):
+            assert ph in (kw.get("ExpressionAttributeNames") or {}), (ph, expr)
+        for ph in re.findall(r":v\d+", expr):
+            assert ph in (kw.get("ExpressionAttributeValues") or {}), (ph, expr)
+
+    def update_item(self, **kw):
+        self.calls.append(("update", kw))
+        self.check(kw["UpdateExpression"] + " " + kw.get("ConditionExpression", ""), kw)
+        return {}
+
+    def put_item(self, **kw):
+        self.calls.append(("put", kw))
+        self.check(kw.get("ConditionExpression", ""), kw)
+        return {}
+
+
+def test_dynamodb_requests_are_well_formed():
+    r = _Rec()
+    d = TP.DB(r)
+    d.update("RL#tp-x", "a#1", add={"n": 1}, set_={"ttl": 5}, cond=[("lt", "n", 5)])
+    u = r.calls[-1][1]
+    assert u["UpdateExpression"] == "SET #a0 = :v0 ADD #a1 :v1" and u["ConditionExpression"] == "(attribute_not_exists(#a1) OR #a1 < :v2)"
+    assert u["ExpressionAttributeNames"] == {"#a0": "ttl", "#a1": "n"}
+    d.put({"pk": "a", "sk": "b"}, cond=["absent"])
+    assert r.calls[-1][1]["ConditionExpression"] == "attribute_not_exists(#a0)" and r.calls[-1][1]["ExpressionAttributeNames"] == {"#a0": "pk"}
+    ok, _ = d.transact([{"put": {"pk": "a", "sk": "b", "n": 1, "lg": [], "home": {"id": None, "name": "x"}}, "cond": ["absent"]},
+                        {"update": ("TP#P#X", "META"), "append": {"lg": ["L1"]}, "add": {"np": 1}, "set": {"seen": "t"},
+                         "cond": ["present", ("size_lt", "lg", 20)]},
+                        {"delete": ("TP#L#1", "M#X"), "cond": ["present"]}])
+    assert ok and len(r.calls[-1][1]) == 3
+    up = r.calls[-1][1][1]["Update"]
+    names = {v: k for k, v in up["ExpressionAttributeNames"].items()}
+    assert f"{names['lg']} = list_append(if_not_exists({names['lg']}, " in up["UpdateExpression"] and f"ADD {names['np']} " in up["UpdateExpression"]
+    assert up["ConditionExpression"] == f"attribute_exists({names['pk']}) AND (attribute_not_exists({names['lg']}) OR size({names['lg']}) < :v0)"
+    assert up["ExpressionAttributeValues"][":v0"] == {"N": "20"} and up["Key"] == {"pk": {"S": "TP#P#X"}, "sk": {"S": "META"}}
+    assert r.calls[-1][1][0]["Put"]["Item"]["home"] == {"M": {"id": {"NULL": True}, "name": {"S": "x"}}}
