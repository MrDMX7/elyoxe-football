+def _season(W):
+    """Three players, two leagues (one of them only for the UAE league), three matches."""
+    a, b, c = join_player("سالم"), join_player("خالد", ip="5.5.5.5"), join_player("علي", ip="6.6.6.6")
+    L1 = call("POST", "/api/tifo/predict/league", {"name": 0}, token=a["token"])[1]
+    L2 = call("POST", "/api/tifo/predict/league", {"name": 1, "comps": [538]}, token=b["token"])[1]
+    for x in (b, c):
+        call("POST", "/api/tifo/predict/join", {"invite": L1["invite"]}, token=x["token"])
+    call("POST", "/api/tifo/predict/join", {"invite": L2["invite"]}, token=a["token"])
+    W.match(md(101, "2026-10-10T14:00:00Z"))
+    W.match(md(102, "2026-10-10T15:00:00Z", comp=47))
+    W.match(md(103, "2026-10-10T16:00:00Z"))
+    picks = [(a, {101: (2, 1), 102: (1, 1), 103: (0, 2)}), (b, {101: (3, 2), 102: (0, 0), 103: (1, 0)}), (c, {101: (0, 1), 102: (2, 0)})]
+    for p, ms in picks:
+        for mid, (h, x) in ms.items():
+            assert call("PUT", "/api/tifo/predict/pick", {"match": mid, "h": h, "a": x}, token=p["token"])[0] == 200
+    return a, b, c, L1, L2
