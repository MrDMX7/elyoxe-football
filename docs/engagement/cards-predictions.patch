+def call(method, path, body=None, token=None, ip="1.2.3.4", q=None):
+    h = {"x-viewer-ip": ip}
+    if token:
+        h["x-tifo-player"] = token
+    ev = {"rawPath": path, "requestContext": {"http": {"method": method, "sourceIp": ip}}, "headers": h, "body": json.dumps(body or {})}
+    if q:
+        ev["queryStringParameters"] = q
+    r = app.handler(ev, None)
+    return r["statusCode"], (json.loads(r["body"]) if r.get("body") else None)
