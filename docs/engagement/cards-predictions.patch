+"""«توقع وتحدى ربعك»: score predictions with friends on tifo.elyoxe.com, no signup (Tifo item 8, owner 2026-10-06).
+
+Play: guess the score of an upcoming match. 5 points for the exact score, 3 for the right goal difference (a draw with
+another score included), 2 for the right winner or draw, 0 otherwise. The score is the final one before penalties (extra
+time counts) as Tifo's own match file (v1/match/<id>.json) has it, a result awarded after the match included (saas/football
+compute/awarded.py). A pick locks at kickoff: this server's clock against the kickoff in Tifo's data.
+
+Identity: a nickname and a device key. POST /me makes a player and returns, once, a token the device keeps and a
+10-character recovery code the player writes down; the code gives another phone its own token. No account, email or
+password; keys and codes are kept only as HMACs (the cards secret), never an IP (rate limits key an HMAC of it, for an hour
+or two days).
+Leagues: private, joined through a link shared on WhatsApp (https://tifo.elyoxe.com/predict/?j=<invite>), named from a fixed
+list (no free text beyond nicknames), up to LEAGUE_CAP members, LEAGUES_MAX leagues a player, CREATE_DAY new leagues a day.
+A league counts the picks its members make in its competitions (every competition when it names none), from the moment
+they are members.
+
+Routes (the tifo distribution sends /api/tifo/* here with X-Origin-Key; a player is the header X-Tifo-Player: <pid>.<key>)
+  POST   /api/tifo/predict/me        {nick}            -> 201 {pid, token, code, nick}
+  GET    /api/tifo/predict/me        player            -> {pid, nick, pts, ex, df, oc, n, np, leagues, picks}
+  PATCH  /api/tifo/predict/me        player {nick}     -> {nick}
+  POST   /api/tifo/predict/recover   {code}            -> {pid, token, nick}
+  POST   /api/tifo/predict/code      player            -> {code}       a new recovery code; the old one stops working
+  PUT    /api/tifo/predict/pick      player {match, h, a} -> {match, h, a, at, ko}         409 once the match kicked off
+  GET    /api/tifo/predict/match?id= player            -> {match, ko, locked, pick, result, pts, k}
+  GET    /api/tifo/predict/picks?ids=1,2,…  player     -> {picks: {match: {h, a, pts, k}}}   (day lists, up to 60 ids)
+  POST   /api/tifo/predict/league    player {name, comps} -> 201 {lid, name, owner_nick, invite, url}
+  GET    /api/tifo/predict/league?id=<lid>[&match=<id>] member -> {league, members (ranked), me[, match]}
+  POST   /api/tifo/predict/join      player {invite}   -> {lid, name, owner_nick, already}
+  POST   /api/tifo/predict/leave     player {lid}      -> 204
+  GET    /api/tifo/predict/invite?code=               -> {name, owner_nick, n, cap, full}
+  EventBridge every 10 minutes {"tifo_predict": "score"} -> score_due(): finished matches, then the awarded re-checks
+  by hand {"tifo_predict": "recheck", "match": <id>}       -> recheck(): a result decided long after the match
+
+Table «cards» (pk, sk), single table, pay per request:
+  TP#P#<pid>      | META             {nick, nk, keys:[hmac…], code: hmac, created, seen, pts, ex, df, oc, n, np, lg:[lid…], ttl}
+  TP#P#<pid>      | PK#<ko>#<match>  {match, h, a, at, ko, comp, home, away, pts, k, sv, rh, ra, ttl}   «توقعاتي», by kickoff
+  TP#M#<match>    | P#<pid>          {h, a, at, psk, comp, pts, k, sv, lg, ttl}                       a match's picks (scoring)
+  TP#M#<match>    | RESULT           {h, a, st, v, at, ttl}                                          the result scored, version v
+  TP#CODE#<hmac>  | META             {pid}
+  TP#L#<lid>      | META             {name, owner, owner_nick, comps, n, invite, created, ttl}
+  TP#L#<lid>      | M#<pid>          {nick, joined, pts, ex, df, oc, n, ttl}
+  TP#INV#<invite> | META             {lid}
+  TP#PEND         | <ko>#<match>     {match, ko, ttl}         a match with picks waiting for its result
+  TP#RECHECK      | <due>#<match>    {match, ttl}             a scored match read again at +1 and +3 days (awarded results)
+  RL#tp-… | <hmac(ip) or pid>#<hour|day>  and  STAT#tp-… | D#<day>    rate-limit counters with a TTL
+k: x exact, d goal difference, o winner or draw, m missed, v void (postponed or cancelled for good). sv: the result version a
+pick was scored at; scoring a pick is one transaction (the pick at version v, the player's and its leagues' totals) that a
+second run loses, so a scoring run that dies half-way is simply run again.
+"""
+import hashlib, hmac, json, re, secrets, time
+from datetime import datetime, timedelta, timezone
+
+import app as A
+
+EXACT, DIFF, OUTCOME = 5, 3, 2
+LEAGUE_CAP, LEAGUES_MAX, CREATE_DAY, JOIN_DAY, RENAME_DAY, CODE_DAY = 50, 20, 3, 20, 3, 3
+DEVICE_KEYS = 5
+COMPS_MAX = 5
+GOALS_MAX = 20
+PICK_AHEAD_DAYS = 30
+SITE = "https://tifo.elyoxe.com"
+LEAGUE_NAMES = ["دوري الربع", "دوري الشباب", "دوري العايلة", "دوري الدوام", "دوري الشلة", "دوري الديوانية", "دوري المجلس",
+                "دوري الفريج", "دوري الجامعة", "دوري الكشتة"]
+LIMITS = {   # name: (cap, window) — window "h" an hour, "d" a UAE-agnostic UTC day
+    "reg_ip_h": (5, "h"), "reg_ip_d": (20, "d"), "reg_d": (5000, "d"), "rec_ip_h": (10, "h"), "rec_d": (3000, "d"),
+    "auth_ip_h": (30, "h"), "w_p_h": (150, "h"), "w_ip_h": (600, "h"), "r_ip_h": (1200, "h"), "picks_d": (300_000, "d"),
+    "league_p_d": (CREATE_DAY, "d"), "join_p_d": (JOIN_DAY, "d"), "nick_p_d": (RENAME_DAY, "d"), "code_p_d": (CODE_DAY, "d"),
+    "inv_ip_h": (120, "h"),
+}
+SCORE_AFTER = timedelta(minutes=105)     # a match is looked at for its result this long after kickoff
+RECHECK_AFTER = (timedelta(days=1), timedelta(days=3), timedelta(days=7))   # db/matches.py rewrites 3 days of match pages daily
+GIVE_UP = timedelta(days=14)             # a match with no result this long after its kickoff: its picks are void
+PEND_SCAN, PEND_FETCH = 300, 40          # due matches looked at per run, Tifo match files read per run
+PEND_AGAIN = timedelta(minutes=30)       # a due match that was not final is read again after this (no head-of-line block)
+VOID_AFTER = timedelta(days=3)           # cancelled / abandoned this long: void
+PICK_DAYS = 400                          # picks and players stay this long after their last kickoff / activity
+CROCK = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
+FINAL = ("finished", "awarded")
+VOIDING = ("cancelled", "abandoned")
+
+
+class Err(Exception):
+    def __init__(self, status, msg):
+        super().__init__(msg)
+        self.status, self.msg = status, msg
+
+
+def now():
+    return datetime.now(timezone.utc)
+
+
+def iso(t):
+    return t.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def parse(s):
+    try:
+        t = datetime.fromisoformat(str(s).replace("Z", "+00:00"))
+        return t if t.tzinfo else t.replace(tzinfo=timezone.utc)
+    except (TypeError, ValueError):
+        return None
+
+
+def tifo_get(path, ttl=60):
+    """Tifo's public data (the data distribution), through the cards Lambda's small cache."""
+    return A._tifo_get(path, ttl)
+
+
+def _int(x):
+    """DynamoDB numbers come back as Decimal."""
+    try:
+        return int(x)
+    except (TypeError, ValueError):
+        return 0
+
+
+def _plain(o):
+    from decimal import Decimal
+    if isinstance(o, Decimal):
+        return int(o) if o == int(o) else float(o)
+    if isinstance(o, dict):
+        return {k: _plain(v) for k, v in o.items()}
+    if isinstance(o, (list, tuple)):
+        return [_plain(v) for v in o]
+    if isinstance(o, set):
+        return sorted(_plain(v) for v in o)
+    return o
+
+
+# ------------------------------------------------------------------ the table
+class _Expr:
+    """Placeholders for every attribute name and value (ttl, name, status… are reserved words in DynamoDB)."""
+    def __init__(self):
+        self.names, self.values, self._n = {}, {}, {}
+
+    def n(self, attr):
+        if attr not in self._n:
+            k = f"#a{len(self._n)}"
+            self._n[attr], self.names[k] = k, attr
+        return self._n[attr]
+
+    def v(self, val):
+        k = f":v{len(self.values)}"
+        self.values[k] = val
+        return k
+
+    def update(self, add=None, set_=None, append=None, remove=None):
+        sets = [f"{self.n(a)} = {self.v(x)}" for a, x in (set_ or {}).items()]
+        sets += [f"{self.n(a)} = list_append(if_not_exists({self.n(a)}, {self.v([])}), {self.v(list(x))})" for a, x in (append or {}).items()]
+        parts = ["SET " + ", ".join(sets)] if sets else []
+        adds = [f"{self.n(a)} {self.v(x)}" for a, x in (add or {}).items()]
+        if adds:
+            parts.append("ADD " + ", ".join(adds))
+        if remove:
+            parts.append("REMOVE " + ", ".join(self.n(a) for a in remove))
+        return " ".join(parts)
+
+    def cond(self, cond):
+        out = []
+        for c in cond or []:
+            if c == "absent":
+                out.append(f"attribute_not_exists({self.n('pk')})")
+            elif c == "present":
+                out.append(f"attribute_exists({self.n('pk')})")
+            elif c[0] == "lt":         # missing counts as below
+                out.append(f"(attribute_not_exists({self.n(c[1])}) OR {self.n(c[1])} < {self.v(c[2])})")
+            elif c[0] == "eq":
+                out.append(f"{self.n(c[1])} = {self.v(c[2])}")
+            elif c[0] == "size_lt":
+                out.append(f"(attribute_not_exists({self.n(c[1])}) OR size({self.n(c[1])}) < {self.v(c[2])})")
+            else:
+                raise ValueError(c)
+        return " AND ".join(out) or None
+
+    def kw(self, serialize=None):
+        out = {}
+        if self.names:
+            out["ExpressionAttributeNames"] = self.names
+        if self.values:
+            out["ExpressionAttributeValues"] = {k: serialize(v) for k, v in self.values.items()} if serialize else self.values
+        return out
+
+
+class DB:
+    """The cards table: items through the boto3 resource, transactions through its client. Conditions are a list of
+    "absent" | "present" | ("lt", attr, n) | ("eq", attr, v) | ("size_lt", attr, n), all of them must hold."""
+    def __init__(self, table):
+        self.t, self.c = table, table.meta.client
+
+    @staticmethod
+    def _failed(e):
+        return getattr(e, "response", {}).get("Error", {}).get("Code") == "ConditionalCheckFailedException"
+
+    def get(self, pk, sk, consistent=False):
+        it = self.t.get_item(Key={"pk": pk, "sk": sk}, ConsistentRead=consistent).get("Item")
+        return _plain(it) if it else None
+
+    def put(self, item, cond=None):
+        e = _Expr()
+        c = e.cond(cond)
+        try:
+            self.t.put_item(Item=item, **({"ConditionExpression": c} if c else {}), **e.kw())
+            return True
+        except A.ClientError as x:
+            if self._failed(x):
+                return False
+            raise
+
+    def update(self, pk, sk, add=None, set_=None, append=None, remove=None, cond=None, ret=False):
+        e = _Expr()
+        u = e.update(add, set_, append, remove)
+        c = e.cond(cond)
+        try:
+            r = self.t.update_item(Key={"pk": pk, "sk": sk}, UpdateExpression=u, **({"ConditionExpression": c} if c else {}), **e.kw(),
+                                   **({"ReturnValues": "ALL_NEW"} if ret else {}))
+            return _plain(r.get("Attributes")) if ret else True
+        except A.ClientError as x:
+            if self._failed(x):
+                return None if ret else False
+            raise
+
+    def delete(self, pk, sk, cond=None):
+        e = _Expr()
+        c = e.cond(cond)
+        try:
+            self.t.delete_item(Key={"pk": pk, "sk": sk}, **({"ConditionExpression": c} if c else {}), **e.kw())
+            return True
+        except A.ClientError as x:
+            if self._failed(x):
+                return False
+            raise
+
+    def query(self, pk, prefix=None, upto=None, limit=None, desc=False, consistent=False):
+        from boto3.dynamodb.conditions import Key
+        kc = Key("pk").eq(pk)
+        if prefix is not None:
+            kc = kc & Key("sk").begins_with(prefix)
+        elif upto is not None:
+            kc = kc & Key("sk").lte(upto)
+        kw = {"KeyConditionExpression": kc, "ScanIndexForward": not desc, "ConsistentRead": consistent}
+        out = []
+        while True:
+            if limit:
+                kw["Limit"] = limit - len(out)
+            r = self.t.query(**kw)
+            out += r.get("Items") or []
+            if not r.get("LastEvaluatedKey") or (limit and len(out) >= limit):
+                return [_plain(i) for i in out]
+            kw["ExclusiveStartKey"] = r["LastEvaluatedKey"]
+
+    def batch_get(self, keys):
+        out, todo = [], [{"pk": p, "sk": s} for p, s in dict.fromkeys(keys)]
+        name = self.t.name
+        while todo:
+            chunk, todo = todo[:100], todo[100:]
+            req = {name: {"Keys": chunk}}
+            for _ in range(5):
+                r = A.ddb.batch_get_item(RequestItems=req)
+                out += (r.get("Responses") or {}).get(name) or []
+                req = r.get("UnprocessedKeys") or {}
+                if not req:
+                    break
+                time.sleep(0.2)
+        return [_plain(i) for i in out]
+
+    def transact(self, ops):
+        """All or nothing. -> (True, []) or (False, [reason code per op]) when a condition failed."""
+        from boto3.dynamodb.types import TypeSerializer
+        ser = TypeSerializer().serialize
+        name, items = self.t.name, []
+        for op in ops:
+            e = _Expr()
+            c = e.cond(op.get("cond"))
+            base = {"TableName": name, **({"ConditionExpression": c} if c else {})}
+            if "put" in op:
+                x = {"Put": {**base, "Item": {k: ser(v) for k, v in op["put"].items()}}}
+            elif "update" in op:
+                u = e.update(op.get("add"), op.get("set"), op.get("append"), op.get("remove"))
+                x = {"Update": {**base, "Key": {"pk": ser(op["update"][0]), "sk": ser(op["update"][1])}, "UpdateExpression": u}}
+            elif "delete" in op:
+                x = {"Delete": {**base, "Key": {"pk": ser(op["delete"][0]), "sk": ser(op["delete"][1])}}}
+            else:
+                x = {"ConditionCheck": {**base, "Key": {"pk": ser(op["check"][0]), "sk": ser(op["check"][1])}}}
+            next(iter(x.values())).update(e.kw(ser))
+            items.append(x)
+        try:
+            self.c.transact_write_items(TransactItems=items)
+            return True, []
+        except A.ClientError as x:
+            if x.response.get("Error", {}).get("Code") == "TransactionCanceledException":
+                return False, [r.get("Code") for r in x.response.get("CancellationReasons") or []]
+            raise
+
+
+_DB = []
+
+
+def db():
+    if not _DB:
+        _DB.append(DB(A.table))
+    return _DB[0]
+
+
+# ------------------------------------------------------------------ small helpers
+def _rand(n):
+    return "".join(secrets.choice(CROCK) for _ in range(n))
+
+
+def _mac(s):
+    return hmac.new(A.secret(), str(s).encode(), hashlib.sha256).hexdigest()[:40]
+
+
+def _code_norm(s):
+    """Crockford: case-free, I/L read as 1, O as 0, separators ignored."""
+    s = re.sub(r"[\s\-_.]", "", str(s or "")).upper().translate(str.maketrans("ILO", "110"))
+    return s if re.fullmatch(f"[{CROCK}]{{6,16}}", s) else None
+
+
+def _code_show(c):
+    return f"{c[:5]}-{c[5:]}"
+
+
+def _iph(event):
+    return hmac.new(A.secret(), A.client_ip(event).encode(), hashlib.sha256).hexdigest()[:16]
+
+
+def limit(name, who, t=None):
+    """One more of `name` for `who` in its window; Err 429 when over the cap."""
+    cap, win = LIMITS[name]
+    t = t or now()
+    slot = t.strftime("%Y%m%d%H") if win == "h" else t.strftime("%Y%m%d")
+    ttl = int(t.timestamp()) + (7200 if win == "h" else 2 * 86400)
+    pk = f"STAT#tp-{name}" if who is None else f"RL#tp-{name}"
+    sk = f"D#{slot}" if who is None else f"{who}#{slot}"
+    if not db().update(pk, sk, add={"n": 1}, set_={"ttl": ttl}, cond=[("lt", "n", cap)]):
+        raise Err(503 if who is None else 429, "الخدمة مشغولة، جرّب بعدين" if who is None else "طلبات وايد، جرّب بعد شوي")
+
+
+def _body(event):
+    try:
+        return A.body_json(event)
+    except Exception:
+        raise Err(400, "الطلب غير صالح")
+
+
+def _resp(status, body=None):
+    if status == 204:
+        return {"statusCode": 204, "headers": {"cache-control": "no-store"}, "body": ""}
+    return {"statusCode": status, "headers": {"content-type": "application/json; charset=utf-8", "cache-control": "no-store"},
+            "body": json.dumps(_plain(body), ensure_ascii=False)}
+
+
+def _ttl(t, days=PICK_DAYS):
+    return int(t.timestamp()) + days * 86400
+
+
+def _team(t):
+    t = t or {}
+    return {"id": t.get("id"), "name": t.get("name_ar") or t.get("name") or ""}
+
+
+def _sign(x):
+    return (x > 0) - (x < 0)
+
+
+def points(ph, pa, h, a):
+    """(points, kind): 5 exact, 3 goal difference, 2 winner or draw, 0."""
+    if ph == h and pa == a:
+        return EXACT, "x"
+    if ph - pa == h - a:
+        return DIFF, "d"
+    if _sign(ph - pa) == _sign(h - a):
+        return OUTCOME, "o"
+    return 0, "m"
+
+
+# ------------------------------------------------------------------ players
+def player(event, t=None):
+    """The player of X-Tifo-Player: <pid>.<key>, or Err 401."""
+    raw = ((event.get("headers") or {}).get("x-tifo-player") or "").strip()
+    m = re.fullmatch(f"([{CROCK}]{{12}})\\.([{CROCK}]{{26}})", raw)
+    if not m:
+        raise Err(401, "سجّل اسمك أول")
+    p = db().get(f"TP#P#{m.group(1)}", "META", consistent=True)     # a player made a second ago must be found
+    h = _mac(m.group(2))
+    if not p or not any(hmac.compare_digest(h, k) for k in p.get("keys") or []):
+        limit("auth_ip_h", _iph(event), t)
+        raise Err(401, "هالجهاز مب مسجّل، استرجع حسابك بالرمز")
+    p["pid"] = m.group(1)
+    return p
+
+
+def register(event, t):
+    nick, why = _nick(_body(event).get("nick"))
+    iph = _iph(event)
+    for name, who in (("reg_ip_h", iph), ("reg_ip_d", iph), ("reg_d", None)):
+        limit(name, who, t)
+    key = _rand(26)
+    for _ in range(5):
+        pid, code = _rand(12), _rand(10)
+        if not db().put({"pk": f"TP#CODE#{_mac(code)}", "sk": "META", "pid": pid}, cond=["absent"]):
+            continue
+        if db().put({"pk": f"TP#P#{pid}", "sk": "META", "nick": nick, "nk": _nk(nick), "keys": [_mac(key)], "code": _mac(code),
+                     "created": iso(t), "seen": iso(t), "pts": 0, "ex": 0, "df": 0, "oc": 0, "n": 0, "np": 0, "lg": [], "ttl": _ttl(t)},
+                    cond=["absent"]):
+            return _resp(201, {"pid": pid, "token": f"{pid}.{key}", "code": _code_show(code), "nick": nick})
+        db().delete(f"TP#CODE#{_mac(code)}", "META")
+    raise Err(503, "صار خطأ، جرّب مرة ثانية")
+
+
+def _nick(raw):
+    import tifo_badwords as W
+    nick, why = W.nick(raw)
+    if why:
+        raise Err(400, why)
+    return nick, None
+
+
+def _nk(nick):
+    import tifo_badwords as W
+    return W.norm(nick)
+
+
+def recover(event, t):
+    iph = _iph(event)
+    limit("rec_ip_h", iph, t)
+    limit("rec_d", None, t)
+    code = _code_norm(_body(event).get("code"))
+    hit = db().get(f"TP#CODE#{_mac(code)}", "META", consistent=True) if code else None
+    p = db().get(f"TP#P#{hit['pid']}", "META") if hit else None
+    if not p:
+        raise Err(404, "الرمز غلط، تأكد منه")
+    key = _rand(26)
+    keys = (list(p.get("keys") or []) + [_mac(key)])[-DEVICE_KEYS:]
+    db().update(f"TP#P#{hit['pid']}", "META", set_={"keys": keys, "seen": iso(t), "ttl": _ttl(t)}, cond=["present"])
+    return _resp(200, {"pid": hit["pid"], "token": f"{hit['pid']}.{key}", "nick": p.get("nick")})
+
+
+def new_code(event, p, t):
+    limit("code_p_d", p["pid"], t)
+    for _ in range(5):
+        code = _rand(10)
+        if db().put({"pk": f"TP#CODE#{_mac(code)}", "sk": "META", "pid": p["pid"]}, cond=["absent"]):
+            break
+    else:
+        raise Err(503, "صار خطأ، جرّب مرة ثانية")
+    db().update(f"TP#P#{p['pid']}", "META", set_={"code": _mac(code)}, cond=["present"])
+    if p.get("code"):
+        db().delete(f"TP#CODE#{p['code']}", "META")
+    return _resp(200, {"code": _code_show(code)})
+
+
+def rename(event, p, t):
+    nick, _ = _nick(_body(event).get("nick"))
+    limit("nick_p_d", p["pid"], t)
+    db().update(f"TP#P#{p['pid']}", "META", set_={"nick": nick, "nk": _nk(nick), "seen": iso(t)}, cond=["present"])
+    for lid in p.get("lg") or []:          # the leagues show the new name
+        db().update(f"TP#L#{lid}", f"M#{p['pid']}", set_={"nick": nick}, cond=["present"])
+    return _resp(200, {"nick": nick})
+
+
+def me(p):
+    picks = db().query(f"TP#P#{p['pid']}", prefix="PK#", desc=True, limit=80)
+    lg = [x for x in db().batch_get([(f"TP#L#{lid}", "META") for lid in p.get("lg") or []])]
+    by = {x["pk"][5:]: x for x in lg}
+    leagues = [_league_pub(lid, by[lid]) for lid in p.get("lg") or [] if lid in by]
+    out = {k: _int(p.get(k)) for k in ("pts", "ex", "df", "oc", "n", "np")}
+    return _resp(200, {"pid": p["pid"], "nick": p.get("nick"), **out, "leagues": leagues,
+                       "picks": [{"match": _int(x.get("match")), "h": _int(x.get("h")), "a": _int(x.get("a")), "ko": x.get("ko"), "comp": x.get("comp"),
+                                  "home": x.get("home"), "away": x.get("away"), "pts": x.get("pts"), "k": x.get("k"),
+                                  "res": [x["rh"], x["ra"]] if x.get("rh") is not None else None} for x in picks if x.get("match")]})
+
+
+# ------------------------------------------------------------------ picks
+def _match(mid, ttl=30):
+    md = tifo_get(f"match/{mid}.json", ttl)
+    if not isinstance(md, dict) or md.get("id") != mid:
+        raise Err(404, "ما لقينا المباراة")
+    return md
+
+
+def _locked(md, t):
+    ko = parse(md.get("kickoff_utc"))
+    return md.get("status") != "scheduled" or not ko or t >= ko
+
+
+def pick(event, p, t):
+    b = _body(event)
+    try:
+        mid, h, a = int(b.get("match")), int(b.get("h")), int(b.get("a"))
+    except (TypeError, ValueError):
+        raise Err(400, "التوقع غير صالح")
+    if not (0 < mid < 10 ** 12) or not (0 <= h <= GOALS_MAX and 0 <= a <= GOALS_MAX):
+        raise Err(400, "التوقع غير صالح")
+    limit("w_p_h", p["pid"], t)
+    limit("w_ip_h", _iph(event), t)
+    limit("picks_d", None, t)
+    md = _match(mid)
+    ko = parse(md.get("kickoff_utc"))
+    if md.get("time_tbd") or md.get("date_tbd"):
+        raise Err(409, "موعد المباراة ما تحدد للحين")
+    if md.get("status") in ("postponed",) + VOIDING:
+        raise Err(409, "المباراة تأجلت أو ألغيت")
+    if _locked(md, t):
+        raise Err(409, "انقفل التوقع، المباراة بدت")
+    if ko - t > timedelta(days=PICK_AHEAD_DAYS):
+        raise Err(409, "بدري، التوقع يفتح قبل المباراة بشهر")
+    old = db().get(f"TP#M#{mid}", f"P#{p['pid']}", consistent=True)
+    psk = (old or {}).get("psk") or f"PK#{iso(ko)}#{mid}"
+    at, ttl = iso(t), _ttl(ko)
+    ops = [{"put": {"pk": f"TP#M#{mid}", "sk": f"P#{p['pid']}", "h": h, "a": a, "at": at, "psk": psk, "comp": md.get("comp"), "ttl": ttl}},
+           {"put": {"pk": f"TP#P#{p['pid']}", "sk": psk, "match": mid, "h": h, "a": a, "at": at, "ko": md.get("kickoff_utc"),
+                    "comp": md.get("comp"), "comp_name": md.get("comp_name_ar") or "", "home": _team(md.get("home")),
+                    "away": _team(md.get("away")), "ttl": ttl}},
+           {"update": (f"TP#P#{p['pid']}", "META"), "add": {"np": 0 if old else 1}, "set": {"seen": at, "ttl": _ttl(t)}, "cond": ["present"]}]
+    ok, _ = db().transact(ops)
+    if not ok:
+        raise Err(409, "ما انحفظ التوقع، جرّب مرة ثانية")
+    db().put({"pk": "TP#PEND", "sk": f"{iso(ko)}#{mid}", "match": mid, "ko": iso(ko), "ttl": _ttl(ko, 30)}, cond=["absent"])
+    return _resp(200, {"match": mid, "h": h, "a": a, "at": at, "ko": md.get("kickoff_utc")})
+
+
+def match_view(event, p, t):
+    q = event.get("queryStringParameters") or {}
+    try:
+        mid = int(q.get("id"))
+    except (TypeError, ValueError):
+        raise Err(400, "المباراة؟")
+    limit("r_ip_h", _iph(event), t)
+    md = _match(mid, 60)
+    mine = db().get(f"TP#M#{mid}", f"P#{p['pid']}")
+    res = db().get(f"TP#M#{mid}", "RESULT")
+    return _resp(200, {"match": mid, "ko": md.get("kickoff_utc"), "locked": _locked(md, t),
+                       "pick": {"h": mine["h"], "a": mine["a"], "at": mine.get("at")} if mine else None,
+                       "result": {"h": res.get("h"), "a": res.get("a"), "st": res.get("st")} if res else None,
+                       "pts": (mine or {}).get("pts"), "k": (mine or {}).get("k")})
+
+
+def picks_view(event, p, t):
+    q = event.get("queryStringParameters") or {}
+    ids = [int(x) for x in re.findall(r"\d{1,12}", str(q.get("ids") or ""))][:60]
+    limit("r_ip_h", _iph(event), t)
+    got = db().batch_get([(f"TP#M#{mid}", f"P#{p['pid']}") for mid in ids])
+    return _resp(200, {"picks": {x["pk"][5:]: {"h": x["h"], "a": x["a"], "pts": x.get("pts"), "k": x.get("k")} for x in got}})
+
+
+# ------------------------------------------------------------------ leagues
+def _league_pub(lid, L):
+    return {"lid": lid, "name": LEAGUE_NAMES[_int(L.get("name")) % len(LEAGUE_NAMES)], "owner_nick": L.get("owner_nick"), "n": _int(L.get("n")),
+            "comps": [_int(c) for c in L.get("comps") or []], "invite": L.get("invite"), "url": f"{SITE}/predict/?j={L.get('invite')}", "cap": LEAGUE_CAP}
+
+
+def create_league(event, p, t):
+    b = _body(event)
+    try:
+        name = int(b.get("name"))
+        comps = [int(c) for c in (b.get("comps") or [])]
+    except (TypeError, ValueError):
+        raise Err(400, "اختار اسم الدوري من القائمة")
+    if not 0 <= name < len(LEAGUE_NAMES) or len(comps) > COMPS_MAX or any(not 0 < c < 10 ** 7 for c in comps):
+        raise Err(400, "اختار اسم الدوري من القائمة")
+    if len(p.get("lg") or []) >= LEAGUES_MAX:
+        raise Err(409, f"وصلت حد الدوريات ({LEAGUES_MAX})")
+    limit("league_p_d", p["pid"], t)
+    limit("w_ip_h", _iph(event), t)
+    for _ in range(5):
+        lid, inv = _rand(10), _rand(8)
+        ops = [{"put": {"pk": f"TP#INV#{inv}", "sk": "META", "lid": lid}, "cond": ["absent"]},
+               {"put": {"pk": f"TP#L#{lid}", "sk": "META", "name": name, "owner": p["pid"], "owner_nick": p.get("nick"), "comps": sorted(set(comps)),
+                        "n": 1, "invite": inv, "created": iso(t), "ttl": _ttl(t)}, "cond": ["absent"]},
+               {"put": {"pk": f"TP#L#{lid}", "sk": f"M#{p['pid']}", "nick": p.get("nick"), "joined": iso(t), "pts": 0, "ex": 0, "df": 0,
+                        "oc": 0, "n": 0, "ttl": _ttl(t)}},
+               {"update": (f"TP#P#{p['pid']}", "META"), "append": {"lg": [lid]}, "set": {"seen": iso(t)},
+                "cond": ["present", ("size_lt", "lg", LEAGUES_MAX)]}]
+        ok, why = db().transact(ops)
+        if ok:
+            L = db().get(f"TP#L#{lid}", "META", consistent=True)
+            return _resp(201, _league_pub(lid, L))
+        if why[-1:] == ["ConditionalCheckFailed"]:
+            raise Err(409, f"وصلت حد الدوريات ({LEAGUES_MAX})")
+    raise Err(503, "صار خطأ، جرّب مرة ثانية")
+
+
+def _invite(code):
+    c = _code_norm(code)
+    hit = db().get(f"TP#INV#{c}", "META") if c and len(c) == 8 else None
+    if not hit:
+        raise Err(404, "رابط الدوري مب صالح")
+    L = db().get(f"TP#L#{hit['lid']}", "META")
+    if not L:
+        raise Err(404, "الدوري انحذف")
+    return hit["lid"], L
+
+
+def invite_view(event, t):
+    limit("inv_ip_h", _iph(event), t)
+    lid, L = _invite((event.get("queryStringParameters") or {}).get("code"))
+    pub = _league_pub(lid, L)
+    return _resp(200, {k: pub[k] for k in ("name", "owner_nick", "n", "cap")} | {"full": pub["n"] >= LEAGUE_CAP})
+
+
+def join(event, p, t):
+    lid, L = _invite(_body(event).get("invite"))
+    if lid in (p.get("lg") or []):
+        return _resp(200, {**_league_pub(lid, L), "already": True})
+    if len(p.get("lg") or []) >= LEAGUES_MAX:
+        raise Err(409, f"وصلت حد الدوريات ({LEAGUES_MAX})")
+    limit("join_p_d", p["pid"], t)
+    limit("w_ip_h", _iph(event), t)
+    ops = [{"update": (f"TP#L#{lid}", "META"), "add": {"n": 1}, "set": {"ttl": _ttl(t)}, "cond": ["present", ("lt", "n", LEAGUE_CAP)]},
+           {"put": {"pk": f"TP#L#{lid}", "sk": f"M#{p['pid']}", "nick": p.get("nick"), "joined": iso(t), "pts": 0, "ex": 0, "df": 0, "oc": 0,
+                    "n": 0, "ttl": _ttl(t)}, "cond": ["absent"]},
+           {"update": (f"TP#P#{p['pid']}", "META"), "append": {"lg": [lid]}, "set": {"seen": iso(t)},
+            "cond": ["present", ("size_lt", "lg", LEAGUES_MAX)]}]
+    ok, why = db().transact(ops)
+    if not ok:
+        if why and why[0] == "ConditionalCheckFailed":
+            raise Err(409, f"الدوري مليان ({LEAGUE_CAP} لاعب)")
+        if len(why) > 1 and why[1] == "ConditionalCheckFailed":
+            return _resp(200, {**_league_pub(lid, L), "already": True})
+        raise Err(409, f"وصلت حد الدوريات ({LEAGUES_MAX})")
+    return _resp(200, {**_league_pub(lid, dict(L, n=_int(L.get("n")) + 1)), "already": False})
+
+
+def leave(event, p, t):
+    lid = str(_body(event).get("lid") or "")
+    if lid not in (p.get("lg") or []):
+        raise Err(404, "مب عضو في هالدوري")
+    limit("w_p_h", p["pid"], t)
+    ok, _ = db().transact([{"delete": (f"TP#L#{lid}", f"M#{p['pid']}"), "cond": ["present"]},
+                           {"update": (f"TP#L#{lid}", "META"), "add": {"n": -1}, "cond": ["present"]},
+                           {"update": (f"TP#P#{p['pid']}", "META"), "set": {"lg": [x for x in p["lg"] if x != lid]}, "cond": ["present"]}])
+    if not ok:                              # the membership or the league was gone already: just forget it
+        db().update(f"TP#P#{p['pid']}", "META", set_={"lg": [x for x in p["lg"] if x != lid]}, cond=["present"])
+    L = db().get(f"TP#L#{lid}", "META", consistent=True)
+    if L and _int(L.get("n")) <= 0:         # the last one out: the league and its link go
+        db().delete(f"TP#INV#{L.get('invite')}", "META")
+        db().delete(f"TP#L#{lid}", "META", cond=[("lt", "n", 1)])
+    return _resp(204)
+
+
+def rank(members):
+    """Most points, then exact scores, then goal differences, then winners; ties share a rank."""
+    key = lambda m: (-_int(m.get("pts")), -_int(m.get("ex")), -_int(m.get("df")), -_int(m.get("oc")))   # noqa: E731
+    out, last, r = [], None, 0
+    for i, m in enumerate(sorted(members, key=lambda m: (key(m), m.get("joined") or "", m.get("nick") or ""))):
+        if key(m) != last:
+            r, last = i + 1, key(m)
+        out.append(dict(m, rank=r))
+    return out
+
+
+def league_view(event, p, t):
+    q = event.get("queryStringParameters") or {}
+    lid = str(q.get("id") or "")
+    if lid not in (p.get("lg") or []):
+        raise Err(404, "مب عضو في هالدوري")
+    limit("r_ip_h", _iph(event), t)
+    L = db().get(f"TP#L#{lid}", "META")
+    if not L:
+        raise Err(404, "الدوري انحذف")
+    ms = [dict(m, pid=m["sk"][2:]) for m in db().query(f"TP#L#{lid}", prefix="M#")]
+    tags = {}
+    for m in ms:                             # two members with one nickname: a short tag tells them apart
+        tags.setdefault(_nk(m.get("nick") or ""), []).append(m["pid"])
+    members = [{"pid": m["pid"], "nick": m.get("nick"), "tag": m["pid"][-3:] if len(tags.get(_nk(m.get("nick") or ""), [])) > 1 else None,
+                "pts": _int(m.get("pts")), "ex": _int(m.get("ex")), "df": _int(m.get("df")), "oc": _int(m.get("oc")), "n": _int(m.get("n")),
+                "rank": m["rank"], "me": m["pid"] == p["pid"]} for m in rank(ms)]
+    out = {"league": _league_pub(lid, L), "members": members, "me": p["pid"]}
+    if q.get("match"):
+        try:
+            mid = int(q["match"])
+        except ValueError:
+            raise Err(400, "المباراة؟")
+        md = _match(mid, 60)
+        got = db().batch_get([(f"TP#M#{mid}", f"P#{m['pid']}") for m in members])
+        if _locked(md, t):                   # after kickoff everybody's pick shows; before it only how many picked
+            out["match"] = {"id": mid, "locked": True, "picks": {x["sk"][2:]: [x["h"], x["a"], x.get("pts"), x.get("k")] for x in got}}
+        else:
+            out["match"] = {"id": mid, "locked": False, "picked": len(got)}
+    return _resp(200, out)
+
+
+# ------------------------------------------------------------------ scoring (EventBridge, every 10 minutes)
+def _result(md):
+    sc = md.get("score") or {}
+    if md.get("status") in FINAL and sc.get("home") is not None and sc.get("away") is not None:
+        return int(sc["home"]), int(sc["away"])
+    return None
+
+
+def score_match(mid, md, version, budget_end=None, log=print):
+    """Score every pick of the match at `version` (1 the first time, +1 when an awarded result changes the score). One
+    transaction per pick: the pick (only if still below this version), the player's totals, the totals of the leagues it
+    counts in. A run that dies half-way leaves the rest for the next run, and never counts a pick twice.
+    -> (scored picks, complete?)"""
+    res = _result(md)
+    if res is None:
+        return 0, False
+    h, a = res
+    picks = db().query(f"TP#M#{mid}", prefix="P#", consistent=True)
+    todo = [x for x in picks if _int(x.get("sv")) < version]
+    players = {x["pk"][5:]: x for x in db().batch_get([(f"TP#P#{x['sk'][2:]}", "META") for x in todo])}
+    lids = {lid for pl in players.values() for lid in pl.get("lg") or []}
+    leagues = {x["pk"][5:]: x for x in db().batch_get([(f"TP#L#{lid}", "META") for lid in lids])}
+    comp, n, t = md.get("comp"), 0, now()
+    for x in todo:
+        if budget_end and time.time() > budget_end:
+            return n, False
+        pid = x["sk"][2:]
+        pl = players.get(pid)
+        pts, k = points(_int(x["h"]), _int(x["a"]), h, a)
+        old_pts, old_k = (_int(x.get("pts")), x.get("k")) if _int(x.get("sv")) else (0, None)
+        dk = {f: (1 if k == c else 0) - (1 if old_k == c else 0) for f, c in (("ex", "x"), ("df", "d"), ("oc", "o"))}
+        add = {"pts": pts - old_pts, **dk, "n": 0 if old_k else 1}
+        mine = list((pl or {}).get("lg") or [])
+        counts = [lid for lid in mine if lid in leagues and (not leagues[lid].get("comps") or comp in [_int(c) for c in leagues[lid]["comps"]])]
+        if old_k:                             # a re-score moves only the leagues that counted it the first time
+            counts = [lid for lid in (x.get("lg") or []) if lid in mine]
+        with_player, with_list = bool(pl), bool(x.get("psk"))
+        for _ in range(3):
+            tagged = [("pick", {"update": (f"TP#M#{mid}", x["sk"]), "set": {"pts": pts, "k": k, "sv": version, "lg": counts},
+                                "cond": ["present", ("lt", "sv", version)]})]
+            if with_list:                     # the copy «توقعاتي» lists
+                tagged.append(("list", {"update": (f"TP#P#{pid}", x["psk"]), "set": {"pts": pts, "k": k, "sv": version, "rh": h, "ra": a},
+                                        "cond": ["present"]}))
+            if with_player:
+                tagged.append(("player", {"update": (f"TP#P#{pid}", "META"), "add": add, "set": {"ttl": _ttl(t)}, "cond": ["present"]}))
+                tagged += [(("league", lid), {"update": (f"TP#L#{lid}", f"M#{pid}"), "add": add, "set": {"ttl": _ttl(t)}, "cond": ["present"]})
+                           for lid in counts]
+            ok, why = db().transact([op for _, op in tagged])
+            if ok:
+                n += 1
+                break
+            gone = {tagged[i][0] for i, w in enumerate(why) if w == "ConditionalCheckFailed" and i < len(tagged)}
+            if "pick" in gone:
+                break                         # scored already at this version (another run got there first)
+            # what went away under us (a membership left, an expired copy): score without it, never count anything twice
+            with_list = with_list and "list" not in gone
+            if "player" in gone:
+                with_player, counts = False, []
+            counts = [lid for lid in counts if ("league", lid) not in gone]
+            log(json.dumps({"tp_score_retry": mid, "gone": sorted(str(g) for g in gone)}))
+        else:
+            return n, False
+    return n, True
+
+
+def _void(mid, version):
+    for x in db().query(f"TP#M#{mid}", prefix="P#", consistent=True):
+        if _int(x.get("sv")) >= version:
+            continue
+        if db().update(f"TP#M#{mid}", x["sk"], set_={"k": "v", "pts": 0, "sv": version}, cond=["present", ("lt", "sv", version)]) and x.get("psk"):
+            db().update(f"TP#P#{x['sk'][2:]}", x["psk"], set_={"k": "v", "pts": 0, "sv": version}, cond=["present"])
+
+
+def score_due(t=None, budget=60, log=print):
+    """Finished matches with picks (TP#PEND), then the awarded re-checks (TP#RECHECK). Cheap: one query each, one Tifo match
+    file per due match, nothing at all when no match is due."""
+    t = t or now()
+    end = time.time() + budget
+    out = {"due": 0, "scored": 0, "picks": 0, "void": 0, "moved": 0, "rechecked": 0, "waiting": 0}
+    for it in db().query("TP#PEND", upto=f"{iso(t - SCORE_AFTER)}#~", limit=PEND_SCAN):
+        if time.time() > end or out["due"] >= PEND_FETCH:
+            break
+        chk = parse(it.get("chk"))
+        if chk and t - chk < PEND_AGAIN:        # looked at a moment ago and still not final: the newer ones go first
+            continue
+        out["due"] += 1
+        mid, ko = _int(it.get("match")), parse(it.get("ko"))
+        md = tifo_get(f"match/{mid}.json", 0)
+        st = (md or {}).get("status")
+        if isinstance(md, dict) and st == "scheduled" and parse(md.get("kickoff_utc")) and parse(md["kickoff_utc"]) > ko:
+            nko = parse(md["kickoff_utc"])     # moved to a later day: wait for the new kickoff
+            db().put({"pk": "TP#PEND", "sk": f"{iso(nko)}#{mid}", "match": mid, "ko": iso(nko), "ttl": _ttl(nko, 30)})
+            db().delete("TP#PEND", it["sk"])
+            out["moved"] += 1
+            continue
+        if isinstance(md, dict) and _result(md):
+            cur = db().get(f"TP#M#{mid}", "RESULT", consistent=True)
+            v = _int((cur or {}).get("v")) or 1
+            n, done = score_match(mid, md, v, end, log)
+            out["picks"] += n
+            if done:
+                h, a = _result(md)
+                db().put({"pk": f"TP#M#{mid}", "sk": "RESULT", "h": h, "a": a, "st": st, "v": v, "at": iso(t), "ttl": _ttl(t)})
+                for after in RECHECK_AFTER:
+                    db().put({"pk": "TP#RECHECK", "sk": f"{iso(t + after)}#{mid}", "match": mid, "ttl": _ttl(t + after, 7)})
+                db().delete("TP#PEND", it["sk"])
+                out["scored"] += 1
+            continue
+        if (st in VOIDING and t - ko > VOID_AFTER) or t - ko > GIVE_UP:
+            _void(mid, 1)
+            db().put({"pk": f"TP#M#{mid}", "sk": "RESULT", "st": "void", "v": 1, "at": iso(t), "ttl": _ttl(t)})
+            db().delete("TP#PEND", it["sk"])
+            out["void"] += 1
+            continue
+        db().update("TP#PEND", it["sk"], set_={"chk": iso(t)}, cond=["present"])     # live still, or no file yet
+        out["waiting"] += 1
+    for it in db().query("TP#RECHECK", upto=f"{iso(t)}#~", limit=40):
+        if time.time() > end:
+            break
+        mid = _int(it.get("match"))
+        md = tifo_get(f"match/{mid}.json", 0)
+        cur = db().get(f"TP#M#{mid}", "RESULT", consistent=True)
+        res = _result(md) if isinstance(md, dict) else None
+        if res and cur and cur.get("st") != "void" and (res != (_int(cur.get("h")), _int(cur.get("a")))):
+            v = _int(cur.get("v")) + 1          # an awarded result (or a late correction): the difference moves every total
+            n, done = score_match(mid, md, v, end, log)
+            out["picks"] += n
+            if not done:
+                continue                       # the next run carries on from the same version
+            db().put({"pk": f"TP#M#{mid}", "sk": "RESULT", "h": res[0], "a": res[1], "st": md.get("status"), "v": v, "at": iso(t), "ttl": _ttl(t)})
+        db().delete("TP#RECHECK", it["sk"])
+        out["rechecked"] += 1
+    if any(out.values()):
+        log(json.dumps({"tifo_predict_score": out}))
+    return out
+
+
+def recheck(mid, t=None):
+    """By hand, for a result decided long after the match ({"tifo_predict": "recheck", "match": <id>} to the function, once
+    the match file has it: python -m db.matches --refresh-ids <id> in saas/football): read it again now."""
+    t = t or now()
+    db().put({"pk": "TP#RECHECK", "sk": f"{iso(t)}#{int(mid)}", "match": int(mid), "ttl": _ttl(t, 7)})
+    return score_due(t)
+
+
+# ------------------------------------------------------------------ routing (called from app.handler)
+def route(event, method, rest):
+    t = now()
+    try:
+        r = rest[0] if rest else ""
+        if r == "me" and method == "POST" and len(rest) == 1:
+            return register(event, t)
+        if r == "recover" and method == "POST":
+            return recover(event, t)
+        if r == "invite" and method == "GET":
+            return invite_view(event, t)
+        p = player(event, t)
+        if r == "me" and method == "GET":
+            limit("r_ip_h", _iph(event), t)
+            return me(p)
+        if r == "me" and method == "PATCH":
+            return rename(event, p, t)
+        if r == "code" and method == "POST":
+            return new_code(event, p, t)
+        if r == "pick" and method == "PUT":
+            return pick(event, p, t)
+        if r == "match" and method == "GET":
+            return match_view(event, p, t)
+        if r == "picks" and method == "GET":
+            return picks_view(event, p, t)
+        if r == "league" and method == "POST":
+            return create_league(event, p, t)
+        if r == "league" and method == "GET":
+            return league_view(event, p, t)
+        if r == "join" and method == "POST":
+            return join(event, p, t)
+        if r == "leave" and method == "POST":
+            return leave(event, p, t)
+        raise Err(404, "غير موجود")
+    except Err as e:
+        return _resp(e.status, {"error": e.msg})
