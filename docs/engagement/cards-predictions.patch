+def test_two_scoring_runs_at_once_count_each_pick_once(W):
+    a, b, c, L1, L2 = _season(W)
+    _finish(W, datetime(2026, 10, 10, 18, 0, tzinfo=timezone.utc))
+    gate, real, held = threading.Barrier(2, timeout=10), W.mem.query, set()
+
+    def query(pk, prefix=None, **kw):                  # both runs hold the same unscored picks before either scores one
+        rows = real(pk, prefix=prefix, **kw)
+        if pk.startswith("TP#M#") and prefix == "P#" and (threading.current_thread().name, pk) not in held:
+            held.add((threading.current_thread().name, pk))
+            gate.wait()
+        return rows
+    W.mem.query = query
+    ts = [threading.Thread(target=TP.score_due, kwargs={"log": lambda s: None}, name=f"run{i}") for i in range(2)]
+    for t in ts:
+        t.start()
+    for t in ts:
+        t.join()
+    W.mem.query = real
+    assert len(held) == 6                              # 3 matches, read by both runs before any write
+    TP.score_due(log=lambda s: None)
+    assert totals(W, a) == (10, 1, 1, 1, 3) and totals(W, b) == (6, 0, 2, 0, 3) and member(W, L1, a) == (10, 1, 1, 1, 3)
