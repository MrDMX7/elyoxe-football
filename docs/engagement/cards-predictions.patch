+"""Nicknames for «توقع وتحدى ربعك»: what gets through, what doesn't. Run: python3 -m pytest tests/test_tifo_badwords.py"""
+import os, sys
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "src"))
+import tifo_badwords as W
+
+GOOD = ["بو راشد", "عيناوي_للأبد", "Abu Saif", "الإماراتي 7", "ريال مدريد", "حزب العين", "مكسيك 1986", "عكس التيار", "تكنيك",
+        "Nigel", "Essex Boy", "Slutsky fan", "Scunthorpe", "Khawaldeh", "Nazir", "خولة", "كلباء", "حمارنة", "Dickson", "Hancock",
