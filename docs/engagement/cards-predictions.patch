@@ -0,0 +1,150 @@
+"""Nicknames for «توقع وتحدى ربعك» (tifo_predict.py): the only text a player types, so the only text we filter.
+
+nick(raw) -> (clean nickname, None) or (None, the reason in Arabic). A nickname is 2-20 characters of Arabic or Latin
+letters, Western digits, spaces, «_», «.», «-» (Arabic-Indic digits become Western ones), at least two letters, at most four
+digits (no phone numbers), no link or handle, no name that passes for Tifo's staff, and nothing from the lists below.
+
+How a nickname is read before the lists (so «ك.ل.ب», «كـــلب», «كلللب», «sh1t» and «fuuuck» are caught):
+  Arabic   tashkeel and tatweel out, every hamza seat to its letter (أ إ آ ٱ -> ا, ؤ -> و, ئ -> ي, ى -> ي, ة -> ه, ء out),
+           Persian letters to Arabic (گ -> ك, ڤ -> ف, پ -> ب, چ -> ج), a letter repeated in a row counted once
+  Latin    lower case, leetspeak digits to letters (0 o, 1 i, 3 e, 4 a, 5 s, 7 t, 8 b, 9 g, @ a, $ s), a second reading for
+           Arabizi (2 a, 3 a, 5 kh, 6 t, 7 h, 8 gh, 9 q) and a third with the digits dropped; a letter of a listed word may be
+           repeated («fuuuck»), a doubled one must stay doubled («nigg», never «Nigel»)
+  STEMS    match anywhere in the letters run together (spaces and punctuation out): long, unambiguous stems
+  WORDS    match a whole word, or the whole nickname run together: words that sit inside innocent ones
+           («كس» in «مكسيك» and «عكس», «زب» in «حزب», «نيك» in «تكنيك», «sex» in «Essex», «slut» in «Slutsky»,
+           «cunt» in «Scunthorpe», «khawal» in «Khawaldeh»)
+The lists hold the common insults, obscenities and slurs of the Gulf, Levantine, Egyptian and Maghrebi dialects plus English
+and Arabizi, and the names of staff. A false positive costs a player one retry with another nickname; a miss is on every
+table of every league that player joins.
+"""
+import re, unicodedata
+
+NICK_MIN, NICK_MAX = 2, 20
+
+AR_STEMS = """
+كسمك كسختك كساختك كسامك كسخت كسيمك منيوك منيوج متناك انيكك انيجك نيكني نيجني ينيكك ينيجك طيز شرموط شراميط قحب عاهر لوطي
+لواط مخنث ديوث ممحون معرص متعرص خنزير خنازير زنجي زنوج مهبل اغتصب اغتصاب يلعن ملعون سكس ابنالكلب بنتالكلب ابنالحرام
+يلعندين صهيون داعش هتلر نازي روافض رافضي نواصب ناصبي صفوي مجوسي
+"""
+AR_WORDS = """
+كس كسك كسي كسه كسها زب زبي زبك زبه زبر عير عيري عيرك اير ايري ايرك نيك نيج ينيك ينيج انيك انيج نياك نياج خول شاذ زاني زانيه
+زنا عرص عرصه قضيب بز بزي تيز كلب الكلب كلاب كلبه يا_كلب حمار الحمار حمير حيوان حقير واطي وسخ وسخه زباله قذر سافل منحط
+تافه خرا خري زق سحاق سحاقيه كافر كفار كفره يهود يهودي بورن بورنو ارهابي
+"""
+LAT_STEMS = """
+fuck fuk fck shit bitch biatch cocksuck dickhead pussy whore faggot nigg asshole bastard motherf wank dildo porn hitler penis
+vagina boob kosom kusom ksomak kosomk sharmo sharmu gahb qahb kahb manyok manyuk manyouk manyook metnak mitnak khanzir khanzeer
+"""
+LAT_WORDS = """
+cunt slut dick cock fag rape sex sexy nazi nazis isis tits anal kys kos kus zeb zib zob zebi zbi teez neek nayek ayre ayri kalb
+hmar hamar khawal
+"""
+STAFF_STEMS = "tifo تيفو elyoxe اليوكس administrator moderator"
+STAFF_WORDS = "admin مشرف مشرفين اداره الاداره ادمن الادمن رسمي official support staff system"
+LINKS = re.compile(r"(?i)https?|www\.|\.(com|net|org|ae|sa|me|io|co)\b|t\.me|wa\.me|@|\bsnap|\binsta|\btiktok|\btelegram")
+
+_TASHKEEL = re.compile("[" + chr(0x0610) + "-" + chr(0x061A) + chr(0x064B) + "-" + chr(0x065F) + chr(0x0670) + chr(0x06D6) + "-"
+                       + chr(0x06ED) + chr(0x0640) + "]")
+_FOLD = str.maketrans({"أ": "ا", "إ": "ا", "آ": "ا", "ٱ": "ا", "ى": "ي", "ة": "ه", "ؤ": "و", "ئ": "ي", "ڤ": "ف", "ڨ": "ج",
+                       "گ": "ك", "ک": "ك", "پ": "ب", "چ": "ج", "ی": "ي", "ھ": "ه", "ء": None})
+_AR_DIGITS = str.maketrans("٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹", "01234567890123456789")
+_LEET = str.maketrans({"0": "o", "1": "i", "3": "e", "4": "a", "5": "s", "7": "t", "8": "b", "9": "g", "@": "a", "$": "s"})
+_ARABIZI = [("5", "kh"), ("7", "h"), ("3", "a"), ("2", "a"), ("6", "t"), ("8", "gh"), ("9", "q")]
+_AR_LETTERS = "ء-يپچڤکگھی"
+_ALLOWED = re.compile(r"^[A-Za-z0-9" + _AR_LETTERS + r" _.\-]+$")
+_LETTER = re.compile(r"[A-Za-z" + _AR_LETTERS + r"]")
+_AR = re.compile(r"[" + _AR_LETTERS + r"]")
+
+
+def _squeeze(s):
+    return re.sub(r"(.)\1+", r"\1", s)
+
+
+def fold_ar(s):
+    """Arabic letters only, one form each, a repeated letter once."""
+    s = _TASHKEEL.sub("", s).translate(_FOLD)
+    return _squeeze("".join(c for c in s if "ء" <= c <= "ي"))
+
+
+def _words(text):
+    return [w for w in re.split(r"[\s_.\-]+", text) if w]
+
+
+def _ar_set(block):
+    return {fold_ar(w.replace("_", "")) for w in block.split()}
+
+
+def _lat_rx(word):
+    """«nigg» -> n+i+g{2,}: each letter may repeat, a doubled letter stays doubled."""
+    return "".join(re.escape(m.group(1)) + ("+" if len(m.group(0)) == 1 else "{%d,}" % len(m.group(0)))
+                   for m in re.finditer(r"(.)\1*", word))
+
+
+def _lat(block):
+    ws = block.split()
+    return re.compile("|".join(_lat_rx(w) for w in ws)), re.compile("^(?:" + "|".join(_lat_rx(w) for w in ws) + ")$")
+
+
+AR_S, AR_W = _ar_set(AR_STEMS), _ar_set(AR_WORDS)
+LAT_S, _ = _lat(LAT_STEMS)
+_, LAT_W = _lat(LAT_WORDS)
+STAFF_AR_S = _ar_set(" ".join(w for w in STAFF_STEMS.split() if _AR.search(w)))
+STAFF_AR_W = _ar_set(" ".join(w for w in STAFF_WORDS.split() if _AR.search(w)))
+STAFF_LAT_S, _ = _lat(" ".join(w for w in STAFF_STEMS.split() if not _AR.search(w)))
+_, STAFF_LAT_W = _lat(" ".join(w for w in STAFF_WORDS.split() if not _AR.search(w)))
+
+
+def _latin_readings(nick):
+    raw = [w for w in _words(nick.lower()) if not _AR.search(w)]
+    leet = [re.sub(r"[^a-z]", "", w.translate(_LEET)) for w in raw]
+    arz = []
+    for w in raw:
+        for a, b in _ARABIZI:
+            w = w.replace(a, b)
+        arz.append(re.sub(r"[^a-z]", "", w))
+    bare = [re.sub(r"[^a-z]", "", w) for w in raw]
+    return [[w for w in ws if w] for ws in (leet, arz, bare)]
+
+
+def bad(nick):
+    """True when the nickname carries an insult, an obscenity, a slur or a staff name, in any reading."""
+    ar = [fold_ar(w) for w in _words(nick) if _AR.search(w)]
+    ar = [w for w in ar if w]
+    run = _squeeze("".join(ar))
+    if ar and (any(s in run for s in AR_S | STAFF_AR_S) or set(ar) & (AR_W | STAFF_AR_W) or run in AR_W | STAFF_AR_W):
+        return True
+    for ws in _latin_readings(nick):
+        if not ws:
+            continue
+        lrun = "".join(ws)
+        if LAT_S.search(lrun) or STAFF_LAT_S.search(lrun):
+            return True
+        if any(LAT_W.match(w) or STAFF_LAT_W.match(w) for w in ws + [lrun]):
+            return True
+    return False
+
+
+def nick(raw):
+    """-> (nickname, None) or (None, reason)."""
+    s = unicodedata.normalize("NFKC", str(raw or "")).translate(_AR_DIGITS)
+    s = re.sub("[​-‏‪-‮⁦-⁩﻿]", "", s)          # bidi and zero-width marks
+    s = re.sub(r"\s+", " ", _TASHKEEL.sub("", s)).strip()
+    if LINKS.search(s):
+        return None, "الاسم ما يكون فيه رابط ولا حساب"
+    if len(s) < NICK_MIN or len(s) > NICK_MAX:
+        return None, f"الاسم من {NICK_MIN} لين {NICK_MAX} حرف"
+    if not _ALLOWED.match(s):
+        return None, "الاسم حروف وأرقام بس"
+    if len(re.findall(r"\d", s)) > 4:
+        return None, "الاسم ما يكون رقم تلفون"
+    if len(_LETTER.findall(s)) < 2:
+        return None, "الاسم لازم يكون فيه حرفين على الأقل"
+    if bad(s):
+        return None, "اختار اسم ثاني"
+    return s, None
+
+
+def norm(s):
+    """The form two nicknames are compared in (a league shows a tag when two members share it)."""
+    return fold_ar(s) + "|" + re.sub(r"[^a-z0-9]", "", str(s).lower())
